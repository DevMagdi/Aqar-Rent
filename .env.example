# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=*

# ── Database (PostgreSQL + PostGIS in docker-compose) ─────────────────────────
DATABASE_URL=postgresql+psycopg://aqar:aqar@localhost:5432/aqar
# Used only by `make test` when TEST_DATABASE_URL is not set (SQLite for speed)
# TEST_DATABASE_URL=sqlite:///./test.db

# ── Redis (worker / rate-limits future) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
BCRYPT_ROUNDS=12

# OTP provider: console | test
OTP_PROVIDER=console
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# ── Storage (local | s3) ──────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_MEDIA=aqar-media
S3_BUCKET_DOCUMENTS=aqar-documents
S3_USE_PATH_STYLE=true

# ── Staff Super Admin (used by `make seed`) ───────────────────────────────────
STAFF_SUPER_ADMIN_EMAIL=admin@aqar-rent.dev
STAFF_SUPER_ADMIN_PASSWORD=ChangeMeAdmin!2026
# Base32 TOTP secret (no padding), e.g. generated by `pyotp.random_base32()`
STAFF_SUPER_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# ── Bank transfer instructions (shown at checkout, Phase 2 receipt upload) ────
BANK_NAME=Example Bank Egypt
BANK_ACCOUNT_NAME=Aqar Rent LLC
BANK_ACCOUNT_NUMBER=1234 5678 9012 3456
BANK_IBAN=EG12 0000 0000 0000 0000 0001 234 567
BANK_SWIFT=EXMPLEGYX

# ── Payments (Phase 2) ────────────────────────────────────────────────────────
# Provider: mock (dev/tests, offline) | paymob (card, Fawry, Vodafone Cash)
PAYMENT_PROVIDER=mock
# HMAC secret for MockProvider webhooks (falls back to SECRET_KEY if empty)
WEBHOOK_SECRET=
# Comma-separated IPs/CIDRs allowed to POST /api/v1/payments/webhook (empty = all)
WEBHOOK_IP_ALLOWLIST=
# POST /orders rate limit per user per hour
ORDER_RATE_LIMIT_PER_HOUR=30
# Bank-transfer receipt upload cap (MB)
BANK_RECEIPT_MAX_MB=5

# ── Paymob (Accept) — all keys/IDs come from the merchant dashboard ──────────
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_FAWRY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=
PAYMOB_CURRENCY=EGP
# Optional endpoint overrides (defaults = documented Accept paths under BASE_URL)
# PAYMOB_AUTH_URL= / PAYMOB_ORDERS_URL= / PAYMOB_PAYMENT_KEYS_URL=
# PAYMOB_PAY_URL= / PAYMOB_REFUND_URL= / PAYMOB_IFRAME_URL_TEMPLATE=
# (template placeholders: {iframe_id} {payment_type} {token})

# ── Fawry standalone (reserved; Fawry currently runs through Paymob kiosk) ────
FAWRY_BASE_URL=
FAWRY_MERCHANT_ID=
FAWRY_SECURITY_CODE=
# Pending Fawry/Vodafone-Cash orders auto-expire after this many hours
FAWRY_EXPIRY_HOURS=48

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Phase 5: growth / trust / anti-fraud / registry ──────────────────────────
# Deployment-standard alias. APP_ENV remains canonical; production → prod.
# Accepted: production | staging | development | test
# ENVIRONMENT=development
VERIFICATION_UPLOAD_RATE_LIMIT_PER_HOUR=10
LEAD_RATE_LIMIT_PER_HOUR=120
OFFICE_INVITE_RATE_LIMIT_PER_HOUR=30
SUBSCRIPTION_RATE_LIMIT_PER_HOUR=10
# MUST stay "none": no official Egyptian digital rental registry exists.
REGISTRY_ADAPTER=none
# Required when APP_ENV=prod (production boot validation):
# WEBHOOK_IP_ALLOWLIST=197.168.0.0/16,196.219.0.0/16
# BANK_ACCOUNT_NUMBER=EG…
