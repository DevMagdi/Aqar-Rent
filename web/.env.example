# Backend origin used by the Next server (SSR fetches + /api proxy)
BACKEND_URL=http://localhost:8000

# Map tiles — any XYZ raster endpoint (no paid key required).
# Defaults to OpenStreetMap when unset.
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_STYLE_NAME=OpenStreetMap

# Dev-only: enables the "simulate payment" buttons for MockProvider checkouts
# Dev/e2e ONLY. The simulate-payment route refuses production/staging.
NEXT_PUBLIC_MOCK_PAY=true
