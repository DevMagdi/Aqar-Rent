# Staging environment — copy to .env.staging and fill in real values.
# NEVER commit .env.staging (it is gitignored).

# --- core ---
APP_ENV=staging
DEBUG=false
SECRET_KEY=                    # openssl rand -hex 32
SITE_URL=https://staging.example.com
LOG_LEVEL=INFO

# --- database / cache / storage ---
DATABASE_URL=postgresql+psycopg://aqar:CHANGE_ME@db:5432/aqar
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_MEDIA=aqar-media-staging
S3_BUCKET_DOCUMENTS=aqar-documents-staging

# --- auth ---
OTP_PROVIDER=console           # switch to the real SMS provider before launch
STAFF_SUPER_ADMIN_EMAIL=admin@staging.example.com
STAFF_SUPER_ADMIN_PASSWORD=   # required in staging/prod
STAFF_SUPER_ADMIN_TOTP_SECRET=

# --- payments (Paymob live keys are a go-live blocker) ---
PAYMENT_PROVIDER=mock          # mock until Paymob credentials are verified
WEBHOOK_SECRET=               # openssl rand -hex 32
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_INTEGRATION_ID_FAWRY=
PAYMOB_HMAC_SECRET=
PAYMOB_IFRAME_ID=

# --- contracts ---
CONTRACT_FEE_EGP=0             # suggested paid tier: 50
CONTRACT_NID_KEY=              # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- maps / errors ---
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
SENTRY_DSN=

# --- ports (docker-compose.staging) ---
API_PORT=8000
WEB_PORT=3000
ADMIN_PORT=5173
